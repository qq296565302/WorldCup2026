worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    server_names_hash_bucket_size 64;

    # =============== dafuweng 官网（HTTP → HTTPS 重定向）===============
    server {
        listen 80;
        server_name dafuweng.zhaoshijun0415.xyz;
        return 301 https://$host$request_uri;
    }

    # dafuweng HTTPS
    server {
        listen 443 ssl;
        server_name dafuweng.zhaoshijun0415.xyz;

        ssl_certificate      ssl/zhaoshijun0415.xyz.pem;
        ssl_certificate_key  ssl/zhaoshijun0415.xyz.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers          HIGH:!aNULL:!MD5;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        location / {
            root C:/frontend/dafuweng;
            index index.html index.htm;
            # SPA 路由回退，末尾不要加 =404
            try_files $uri $uri/ /index.html;
        }
    }

    # =============== WorldCup2026（HTTP → HTTPS 重定向）===============
    server {
        listen 80;
        server_name 2026.zhaoshijun0415.xyz;
        return 301 https://$host$request_uri;
    }

    # WorldCup2026 HTTPS
    server {
        listen 443 ssl;
        server_name 2026.zhaoshijun0415.xyz;

        ssl_certificate      ssl/zhaoshijun0415.xyz.pem;
        ssl_certificate_key  ssl/zhaoshijun0415.xyz.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers          HIGH:!aNULL:!MD5;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        root C:/frontend/worldcup2026;
        index index.html;

        # SPA 路由回退 — 关键修复：去掉 =404，改为 /index.html
        # 之前 try_files $uri $uri/ $uri/index.html =404; 导致二级页面刷新404
        location / {
            try_files $uri $uri/ /index.html;
        }

        # 反向代理：wheniskickoff.com
        location /api/wheniskickoff/ {
            proxy_pass https://wheniskickoff.com/data/v1/;
            proxy_ssl_server_name on;
            proxy_set_header Host wheniskickoff.com;
            proxy_set_header Accept application/json;
        }

        # 反向代理：TheSportsDB
        location /api/thesportsdb/ {
            proxy_pass https://www.thesportsdb.com/api/v1/json/3/;
            proxy_ssl_server_name on;
            proxy_set_header Host www.thesportsdb.com;
            proxy_set_header Accept application/json;
        }

        # 反向代理：懂球帝
        # 固定桌面 User-Agent，防止手机端被重定向到 m.dongqiudi.com 触发 CORS
        location /api/dongqiudi/ {
            proxy_pass https://www.dongqiudi.com/;
            proxy_ssl_server_name on;
            proxy_set_header Host www.dongqiudi.com;
            proxy_set_header Referer https://www.dongqiudi.com/;
            proxy_set_header Accept $http_accept;
            proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36";
            proxy_redirect ~*m\.dongqiudi\.com https://$host/api/dongqiudi;
        }

        # 反向代理：咪咕视频
        location /api/migu/ {
            proxy_pass https://app-sc.miguvideo.com/;
            proxy_ssl_server_name on;
            proxy_set_header Host app-sc.miguvideo.com;
            proxy_set_header Referer https://www.miguvideo.com/;
            proxy_set_header Origin https://www.miguvideo.com;
            proxy_set_header Accept application/json;
            proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36";
        }

        # 静态资源缓存（带 hash 的文件长期缓存）
        location /assets/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # JSON 数据文件缓存（球员数据按需加载）
        location /data/ {
            expires 7d;
            add_header Cache-Control "public";
        }

        # index.html 不缓存，确保每次都获取最新版本
        location = /index.html {
            expires -1;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
    }

    # =============== AgentHub 官网（HTTP → HTTPS 重定向）===============
    server {
        listen 80;
        server_name agenthub.zhaoshijun0415.xyz;
        return 301 https://$host$request_uri;
    }

    # AgentHub HTTPS
    server {
        listen 443 ssl;
        server_name agenthub.zhaoshijun0415.xyz;

        ssl_certificate      ssl/zhaoshijun0415.xyz.pem;
        ssl_certificate_key  ssl/zhaoshijun0415.xyz.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers          HIGH:!aNULL:!MD5;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        location / {
            root C:/frontend/agent;
            index index.html index.htm;
            try_files $uri $uri/ /index.html;
        }
    }

    # =============== 一口暖食 官网（HTTP → HTTPS 重定向）===============
    server {
        listen 80;
        server_name cook.zhaoshijun0415.xyz;
        return 301 https://$host$request_uri;
    }

    # 一口暖食 HTTPS
    server {
        listen 443 ssl;
        server_name cook.zhaoshijun0415.xyz;

        ssl_certificate      ssl/zhaoshijun0415.xyz.pem;
        ssl_certificate_key  ssl/zhaoshijun0415.xyz.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers          HIGH:!aNULL:!MD5;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        location / {
            root C:/frontend/cook;
            index index.html index.htm;
            try_files $uri $uri/ /index.html;
        }
    }

    # =============== 主域名 HTTP → HTTPS 重定向 ===============
    server {
        listen 80 default_server;
        server_name solar.zhaoshijun0415.xyz www.zhaoshijun0415.xyz zhaoshijun0415.xyz;
        return 301 https://$host$request_uri;
    }

    # =============== 主域名 HTTPS ===============
    server {
        listen 443 ssl;
        server_name www.zhaoshijun0415.xyz zhaoshijun0415.xyz;

        ssl_certificate      ssl/zhaoshijun0415.xyz.pem;
        ssl_certificate_key  ssl/zhaoshijun0415.xyz.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers          HIGH:!aNULL:!MD5;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        location / {
            root C:/frontend/dist;
            index index.html index.htm;
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            proxy_pass http://localhost:3003;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # =============== solar HTTPS ===============
    server {
        listen 443 ssl;
        server_name solar.zhaoshijun0415.xyz;

        ssl_certificate      ssl/zhaoshijun0415.xyz.pem;
        ssl_certificate_key  ssl/zhaoshijun0415.xyz.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers          HIGH:!aNULL:!MD5;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        location / {
            root C:/frontend/dist;
            index index.html index.htm;
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            proxy_pass http://localhost:3003;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
